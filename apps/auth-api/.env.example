# Database
DATABASE_URL=postgresql://dev:dev@localhost:5434/auth

# App
PORT=3000
NODE_ENV=development

# Shared with habits-api: HS256 secret used to sign Bearer JWTs on login.
# Must match the JWT_SECRET in apps/habits-api/.env.
# In K8s this comes from secret `auth-jwt-secret` (key: secret).
JWT_SECRET=dev-jwt-secret-change-me-in-production
