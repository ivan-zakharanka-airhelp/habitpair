{
  "name": "habitpair",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @habitpair/auth-api",
    "dev:web": "npm run dev -w @habitpair/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
