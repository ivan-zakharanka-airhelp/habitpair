{
  "name": "habitpair",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n auth,habits,web -c blue,green,magenta \"npm:dev:auth\" \"npm:dev:habits\" \"npm:dev:web\"",
    "dev:auth": "npm run start:dev -w @habitpair/auth-api",
    "dev:habits": "npm run start:dev -w @habitpair/habits-api",
    "dev:web": "npm run dev -w @habitpair/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "depcruise": "depcruise apps --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise apps --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.2.3",
    "dependency-cruiser": "^17.4.3",
    "lefthook": "^2.1.9"
  }
}
