apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: habitpair
type: Opaque
stringData:
  url: "postgresql://user:password@host:5432/auth"
---
apiVersion: v1
kind: Secret
metadata:
  name: habits-db-credentials
  namespace: habitpair
type: Opaque
stringData:
  url: "postgresql://user:password@host:5432/habits"
---
# Shared HS256 secret used by auth-api to sign JWTs and by both services to verify them.
# Generate with: openssl rand -hex 32
apiVersion: v1
kind: Secret
metadata:
  name: auth-jwt-secret
  namespace: habitpair
type: Opaque
stringData:
  secret: "replace-me-with-openssl-rand-hex-32"
